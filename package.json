{
  "name": "forge-pcbuilder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vanilla HTML/CSS/JS + Three.js 3D PC builder with cached AED price sync.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.mjs\" \"*.js\" \"css/*.css\" \"*.html\"",
    "sync-prices": "node js/update-prices.mjs",
    "ci": "node scripts/ci.mjs"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  }
}